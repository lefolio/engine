{
  "name": "@lefolio/engine",
  "version": "0.5.1",
  "description": "LeFolio engine — compile an Obsidian vault into a static Next.js site",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lefolio/engine.git"
  },
  "homepage": "https://github.com/lefolio/engine#readme",
  "bugs": {
    "url": "https://github.com/lefolio/engine/issues"
  },
  "keywords": [
    "lefolio",
    "obsidian",
    "static-site",
    "nextjs",
    "markdown"
  ],
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "lefolio": "./scripts/lefolio.mjs"
  },
  "exports": {
    "./content": "./src/lib/content/index.ts",
    "./seo": "./src/lib/content/page-seo.ts",
    "./markdown": "./src/components/markdown-public.ts",
    "./globals.css": "./src/globals.css"
  },
  "files": [
    "scripts",
    "!scripts/.baseline",
    "!scripts/.baseline/**",
    "!scripts/**/*.test.mjs",
    "scaffold",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "postcss.config.mjs",
    "tsconfig.json",
    "LICENSE",
    "README.md",
    "AGENTS.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "sync-content": "node scripts/lefolio.mjs sync",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:watch": "jest --watch",
    "pack:dry": "npm pack --dry-run"
  },
  "dependencies": {
    "chokidar": "^4.0.3",
    "fast-glob": "^3.3.3",
    "gray-matter": "^4.0.3",
    "js-yaml": "^4.1.0",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1"
  },
  "peerDependencies": {
    "next": "^16.4.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "@tailwindcss/postcss": "^4.1.12",
    "@tailwindcss/typography": "^0.5.16",
    "tailwindcss": "^4.1.12"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.12",
    "@tailwindcss/typography": "^0.5.16",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.17.2",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "eslint": "^9.33.0",
    "eslint-config-next": "^16.4.2",
    "jest": "^30.4.2",
    "next": "^16.4.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwindcss": "^4.1.12",
    "typescript": "^5.9.2"
  }
}
